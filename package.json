{
  "name": "api-docs-automation",
  "version": "1.0.0",
  "description": "Automated testing for Contentstack API documentation — scraping, Try Out validation, Postman comparison, and direct API tests",
  "scripts": {
    "scrape": "ts-node src/cda/scraper/scrapeAll.ts",
    "tryout": "playwright test tests/cda/tryout.spec.ts --reporter=html",
    "newman": "ts-node src/cda/postman/runNewman.ts",
    "compare": "ts-node src/cda/postman/compare.ts",
    "api-test": "vitest run tests/cda/api/",
    "report": "ts-node src/shared/reporter/generateReport.ts",
    "run-all": "npm run scrape && npm run tryout && npm run newman && npm run compare && npm run api-test && npm run report",

    "scrape:cma": "ts-node src/cma/scraper/scrapeAllCMA.ts",
    "tryout:cma": "playwright test tests/cma/tryout-cma.spec.ts --reporter=html",
    "newman:cma": "ts-node src/cma/postman/runNewmanCMA.ts",
    "compare:cma": "ts-node src/cma/postman/compareCMA.ts",
    "report:cma": "ts-node src/shared/reporter/generateReport.ts --cma",
    "cma": "npm run scrape:cma && npm run tryout:cma && npm run newman:cma && npm run compare:cma && npm run report:cma",

    "scrape:analytics": "ts-node src/analytics/scraper/scrapeAllAnalytics.ts",
    "newman:analytics": "ts-node src/analytics/postman/runNewmanAnalytics.ts",
    "compare:analytics": "ts-node src/analytics/postman/compareAnalytics.ts",
    "report:analytics": "ts-node src/shared/reporter/generateReport.ts --analytics",
    "analytics": "npm run scrape:analytics && npm run newman:analytics && npm run compare:analytics && npm run report:analytics",

    "scrape:automations": "ts-node src/automations/scraper/scrapeAllAutomations.ts",
    "newman:automations": "ts-node src/automations/postman/runNewmanAutomations.ts",
    "compare:automations": "ts-node src/automations/postman/compareAutomations.ts",
    "report:automations": "ts-node src/shared/reporter/generateReport.ts --automations",
    "automations": "npm run scrape:automations && npm run newman:automations && npm run compare:automations && npm run report:automations",

    "scrape:brandkit": "ts-node src/brandkit/scraper/scrapeAllBrandKit.ts",
    "newman:brandkit": "ts-node src/brandkit/postman/runNewmanBrandKit.ts",
    "compare:brandkit": "ts-node src/brandkit/postman/compareBrandKit.ts",
    "report:brandkit": "ts-node src/shared/reporter/generateReport.ts --brandkit",
    "brandkit": "npm run scrape:brandkit && npm run newman:brandkit && npm run compare:brandkit && npm run report:brandkit",

    "test": "playwright test"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "newman": "^6.1.3",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/newman": "^5.3.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
