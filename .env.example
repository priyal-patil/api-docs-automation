# ── Contentstack Test Credentials ─────────────────────────────────────────────
# Use a dedicated test/sandbox stack — never production
CS_API_KEY=your_stack_api_key_here
CS_DELIVERY_TOKEN=your_delivery_token_here
CS_MANAGEMENT_TOKEN=your_management_token_here
CS_ACCESS_TOKEN=your_access_token_here
CS_REGION=us           # us | eu | azure-na | azure-eu | gcp-na

# ── Postman ────────────────────────────────────────────────────────────────────
POSTMAN_API_KEY=your_postman_api_key_here
POSTMAN_CDA_COLLECTION_ID=your_cda_collection_id_here
POSTMAN_CMA_COLLECTION_ID=your_cma_collection_id_here
POSTMAN_ANALYTICS_COLLECTION_ID=your_analytics_collection_id_here
POSTMAN_AUTOMATIONS_COLLECTION_ID=your_automations_collection_id_here
POSTMAN_BRANDKIT_COLLECTION_ID=your_brandkit_collection_id_here

# ── Analytics + Automations Management + Brand Kit Management APIs (org-scoped
# auth — different from CMA's management token) ───────────────────────────────
# Only organization Owner/Admin roles can call these endpoints. Shared by all
# three — same auth mechanism (authtoken + organization_uid header).
CS_ORG_UID=your_organization_uid_here
# Preferred: log in fresh every run via POST /v3/user-session — authtokens
# silently expire (Contentstack caps a user at 20 valid tokens; a new login
# anywhere else quietly invalidates the oldest), so a long-lived static token
# WILL eventually 401 with no warning, especially on a shared QA org.
CS_QA_EMAIL=your_org_owner_or_admin_email_here
CS_QA_PASSWORD=your_org_owner_or_admin_password_here
# Fallback only — used if CS_QA_EMAIL/CS_QA_PASSWORD are not set. See
# https://www.contentstack.com/docs/developers/apis/analytics-api#authentication
CS_AUTHTOKEN=your_org_owner_or_admin_authtoken_here

# ── Slack Alerting (via channel email) ────────────────────────────────────────
SLACK_CHANNEL_EMAIL=your_slack_channel_email_here
ALERT_FROM_EMAIL=your_alert_from_email_here
ALERT_EMAIL_PASSWORD=your_gmail_app_password_here

# ── Test Data UIDs (optional — used by Newman to substitute {{variables}}) ────
# If left blank, those Postman requests will be skipped (marked as warning)
# entry_uid: any published entry UID from a content type with published entries
# asset_uid: any published asset UID from your stack
# taxonomy_uid: any taxonomy UID (create one in Contentstack UI if needed)
# term_uid: any term UID under the above taxonomy
CS_ENTRY_UID=
CS_ASSET_UID=
CS_TAXONOMY_UID=
CS_TERM_UID=

# ── Doc URLs ───────────────────────────────────────────────────────────────────
CDA_DOC_URL=https://www.contentstack.com/docs/developers/apis/content-delivery-api
CMA_DOC_URL=https://www.contentstack.com/docs/developers/apis/content-management-api
ANALYTICS_DOC_URL=https://www.contentstack.com/docs/developers/apis/analytics-api
AUTOMATIONS_DOC_URL=https://www.contentstack.com/docs/developers/apis/automations-management-api
BRANDKIT_DOC_URL=https://www.contentstack.com/docs/developers/apis/brand-kit-management-api
