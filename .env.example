# ── Contentstack Test Credentials ─────────────────────────────────────────────
# Use a dedicated test/sandbox stack — never production
CS_API_KEY=your_stack_api_key_here
CS_DELIVERY_TOKEN=your_delivery_token_here
CS_MANAGEMENT_TOKEN=your_management_token_here
CS_ACCESS_TOKEN=your_access_token_here
CS_REGION=us           # us | eu | azure-na | azure-eu | gcp-na

# ── Postman ────────────────────────────────────────────────────────────────────
POSTMAN_API_KEY=your_postman_api_key_here
POSTMAN_CDA_COLLECTION_ID=your_cda_collection_id_here
POSTMAN_CMA_COLLECTION_ID=your_cma_collection_id_here
POSTMAN_ANALYTICS_COLLECTION_ID=your_analytics_collection_id_here
POSTMAN_AUTOMATIONS_COLLECTION_ID=your_automations_collection_id_here
POSTMAN_BRANDKIT_COLLECTION_ID=your_brandkit_collection_id_here
POSTMAN_GENAI_COLLECTION_ID=your_genai_collection_id_here
POSTMAN_KNOWLEDGEVAULT_COLLECTION_ID=your_knowledgevault_collection_id_here
# No CS_API_KEY/CS_DELIVERY_TOKEN needed for this one — runNewmanGraphQL.ts
# and tryout-graphql.spec.ts deliberately use Contentstack's own public
# sample-stack credentials (hardcoded, pre-filled by the doc's own GraphiQL
# Explorer, confirmed live to work) rather than a QA stack, since the 90
# example queries need a real product/category/article content model that
# only that sample stack has. See README "GraphQL" section.
POSTMAN_GRAPHQL_COLLECTION_ID=your_graphql_collection_id_here

# ── Analytics + Automations Management + Brand Kit Management + Generative AI
# + Knowledge Vault APIs (org-scoped auth — different from CMA's management
# token) ───────────────────────────────────────────────────────────────────────
# Only organization Owner/Admin roles can call these endpoints. Shared by all
# five — same auth mechanism (authtoken + organization_uid header).
CS_ORG_UID=your_organization_uid_here
# Preferred: log in fresh every run via POST /v3/user-session — authtokens
# silently expire (Contentstack caps a user at 20 valid tokens; a new login
# anywhere else quietly invalidates the oldest), so a long-lived static token
# WILL eventually 401 with no warning, especially on a shared QA org.
CS_QA_EMAIL=your_org_owner_or_admin_email_here
CS_QA_PASSWORD=your_org_owner_or_admin_password_here
# Fallback only — used if CS_QA_EMAIL/CS_QA_PASSWORD are not set. See
# https://www.contentstack.com/docs/developers/apis/analytics-api#authentication
CS_AUTHTOKEN=your_org_owner_or_admin_authtoken_here

# ── Lytics CDP Management API (org-scoped, same auth as above — no Postman
# collection exists; requests run live against the OpenAPI spec instead) ──────
# A real second Contentstack user in the same org, invited as a disposable
# test collaborator on each run then removed. Without this, the Collaborators
# lifecycle (invite/list/update-roles/remove) is skipped and marked as
# no-test-data rather than false-failed.
CS_QA_SECOND_EMAIL=a_real_second_org_user_email_here

# ── Personalize Management API (uses CS_QA_EMAIL/PASSWORD/CS_AUTHTOKEN above
# for login — no org UID needed for the API calls themselves). There is no
# "create project" endpoint — all calls are scoped to an EXISTING Personalize
# project via x-project-uid. Get one from an existing project in your org
# (Personalize > project > Settings > Project Details), or discover one via
# the undocumented GET /projects on the personalize-api host (not in the
# published OpenAPI spec — found live, see README "Personalize" section).
PERSONALIZE_PROJECT_UID=an_existing_personalize_project_uid_here

# ── Personalize Edge API (public-facing — confirmed live to need NO auth
# token at all, just x-project-uid; reuses PERSONALIZE_PROJECT_UID above) ──────

# ── Launch API (reuses CS_ORG_UID/CS_AUTHTOKEN/CS_QA_EMAIL/CS_QA_PASSWORD
# above — no new secret needed). The reused project/environment/deployment
# UIDs (pre-existing QA-org fixtures used for read-heavy checks) are
# hardcoded constants in src/launch/swagger/runSwaggerLaunch.ts, not env
# vars — they're fixed fixtures, not rotatable config. See README "Launch"
# section for why (creating real disposable ones is expensive/slow — real
# hosting infra + build minutes).

# ── Slack Alerting (via channel email) ────────────────────────────────────────
SLACK_CHANNEL_EMAIL=your_slack_channel_email_here
ALERT_FROM_EMAIL=your_alert_from_email_here
ALERT_EMAIL_PASSWORD=your_gmail_app_password_here

# ── Test Data UIDs (optional — used by Newman to substitute {{variables}}) ────
# If left blank, those Postman requests will be skipped (marked as warning)
# entry_uid: any published entry UID from a content type with published entries
# asset_uid: any published asset UID from your stack
# taxonomy_uid: any taxonomy UID (create one in Contentstack UI if needed)
# term_uid: any term UID under the above taxonomy
CS_ENTRY_UID=
CS_ASSET_UID=
CS_TAXONOMY_UID=
CS_TERM_UID=

# ── Doc URLs ───────────────────────────────────────────────────────────────────
CDA_DOC_URL=https://www.contentstack.com/docs/developers/apis/content-delivery-api
CMA_DOC_URL=https://www.contentstack.com/docs/developers/apis/content-management-api
ANALYTICS_DOC_URL=https://www.contentstack.com/docs/developers/apis/analytics-api
AUTOMATIONS_DOC_URL=https://www.contentstack.com/docs/developers/apis/automations-management-api
BRANDKIT_DOC_URL=https://www.contentstack.com/docs/developers/apis/brand-kit-management-api
GENAI_DOC_URL=https://www.contentstack.com/docs/developers/apis/generative-ai-api
KNOWLEDGEVAULT_DOC_URL=https://www.contentstack.com/docs/developers/apis/knowledge-vault-api
LYTICS_DOC_URL=https://www.contentstack.com/docs/developers/apis/lytics-cdp-management-api
PERSONALIZE_DOC_URL=https://www.contentstack.com/docs/developers/apis/personalize-management-api
PERSONALIZEEDGE_DOC_URL=https://www.contentstack.com/docs/developers/apis/personalize-edge-api
LAUNCH_DOC_URL=https://www.contentstack.com/docs/developers/apis/launch-api
GRAPHQL_DOC_URL=https://www.contentstack.com/docs/developers/apis/graphql-content-delivery-api
ADMINISTRATION_DOC_URL=https://www.contentstack.com/docs/developers/apis/administration-api
# No Postman collection, no CS_API_KEY/CS_DELIVERY_TOKEN, and no live Try Out
# execution for this one — the doc's Try Out panel has no Send/Execute button
# (confirmed live), so this is a pure static doc-description ↔ Try-Out-panel
# param/header comparison. See README "Administration API" section.
